        errorType: 'NOT_PAID',
        order: matchingOrder,
      };
    }

    if (matchingOrder.expiresAt) {
      const isExpired = new Date(matchingOrder.expiresAt).getTime() < Date.now();
      if (isExpired) {
        matchingOrder.status = 'expired';
        this.saveOrders(orders);
        return {
          success: false,
          message: `আপনার সার্ভিসের মেয়াদ (${matchingOrder.durationHours} ঘন্টা) শেষ হয়ে গেছে। দয়া করে নতুন সার্ভিস ক্রয় করুন।`,
          errorType: 'EXPIRED',
          order: matchingOrder,
        };
      }
    }

    if (matchingOrder.status !== 'activated') {
      const activatedAt = new Date().toISOString();
      const expiresAt = new Date(Date.now() + (matchingOrder.durationHours || 1) * 3600 * 1000).toISOString();
      matchingOrder.status = 'activated';
      matchingOrder.activatedAt = activatedAt;
      matchingOrder.expiresAt = expiresAt;
      this.saveOrders(orders);
      // Synchronize activation status to cloud
      firebaseService.updateOrder(matchingOrder.id, {
          status: 'activated',
          activatedAt: activatedAt,
          expiresAt: expiresAt
      });
    }

    return {
      success: true,
      message: `🎉 অভিনন্দন! ৩টি এপিকে সফলভাবে আনলক হয়েছে এবং আপনার কেনা সার্ভিসের ${matchingOrder.durationHours} ঘন্টার লাইভ কাউন্টডাউন টাইমার শুরু হয়েছে!`, order: matchingOrder, }; }  getSalesAnalytics() { const orders = this.getOrders(); const validOrders = orders.filter(o => o.status !== 'rejected'); const totalRevenue = validOrders.reduce((sum, o) => sum + (o.amount \vert{}\vert{} 0), 0); const bkashOrders = validOrders.filter(o => o.paymentMethod === 'bkash'); const nagadOrders = validOrders.filter(o => o.paymentMethod === 'nagad'); const bkashRevenue = bkashOrders.reduce((sum, o) => sum + (o.amount \vert{}\vert{} 0), 0); const nagadRevenue = nagadOrders.reduce((sum, o) => sum + (o.amount \vert{}\vert{} 0), 0); const activeCount = orders.filter(o => { if (o.status !== 'activated') return false; if (!o.expiresAt) return true; return new Date(o.expiresAt).getTime() > Date.now(); }).length;  return { totalOrders: orders.length, validOrdersCount: validOrders.length, totalRevenue, bkashOrdersCount: bkashOrders.length, bkashRevenue, nagadOrdersCount: nagadOrders.length,
